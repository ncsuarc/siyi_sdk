{
  "name": "@siyi-sdk/remote",
  "version": "0.1.0",
  "description": "TypeScript client for the SIYI SDK camera service (JSON-RPC over websocket)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts"
  },
